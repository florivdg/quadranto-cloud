---
import {
  Card,
  CardDescription,
  CardHeader,
  CardTitle,
  CardFooter,
  CardContent,
} from '@/components/ui/card'
import type { Project } from '@/db/schema/projects'
import { Button, buttonVariants } from '@/components/ui/button'
import { CalendarIcon } from 'lucide-vue-next'
import { formatDate } from '@/lib/formatters'
import { createTranslator } from '@/i18n'

interface Props {
  project: Project
}

const { project } = Astro.props
const { locale } = Astro.locals
const t = createTranslator(locale)
---

<Card>
  <CardHeader>
    <CardTitle>{project.title}</CardTitle>
    <CardDescription>{project.description}</CardDescription>
  </CardHeader>

  <CardContent>
    <div class="text-muted-foreground flex space-x-4 text-sm">
      <div class="flex items-center">
        <CalendarIcon class="mr-1 size-4" />
        {
          project.dueDate ? (
            <time datetime={project.dueDate}>
              {formatDate(project.dueDate, locale)}
            </time>
          ) : (
            <span class="italic">{t.common.noDueDate}</span>
          )
        }
      </div>
    </div>
  </CardContent>

  <CardFooter>
    <Button asChild>
      <a
        href={`/projects/${project.id}`}
        class:list={[buttonVariants({ variant: 'outline' }), 'w-full']}
        >{t.common.showAllTasks}</a
      >
    </Button>
  </CardFooter>
</Card>
