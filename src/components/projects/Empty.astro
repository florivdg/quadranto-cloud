---
import NewProjectDialog from '@/components/projects/NewProjectDialog.vue'
import { createTranslator } from '@/i18n'

const { locale } = Astro.locals
const t = createTranslator(locale)
---

<div
  class="flex flex-1 items-center justify-center rounded-lg border border-dashed p-6 shadow-xs lg:p-6"
>
  <div class="flex flex-col items-center gap-1 text-center">
    <h3 class="text-2xl font-bold tracking-tight">
      {t.projects.noProjectsYet}
    </h3>
    <p class="text-muted-foreground text-sm">
      {t.projects.startPlanning}
    </p>
    <div class="mt-4">
      <NewProjectDialog variant="default" locale={locale} client:load />
    </div>
  </div>
</div>
