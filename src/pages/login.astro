---
import App from '@/layouts/App.astro'
import LoginView from '@/components/views/Login.vue'

const { user, locale } = Astro.locals
if (user) {
  return Astro.redirect('/')
}
---

<App>
  <main class="container flex min-h-dvh items-center justify-center">
    <LoginView locale={locale} client:load />
  </main>
</App>
