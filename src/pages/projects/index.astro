---
import Empty from '@/components/projects/Empty.astro'
import { listProjects } from '@/db/client/projects'
import ProjectCard from '@/components/projects/ProjectCard.astro'
import App from '@/layouts/App.astro'
import Main from '@/layouts/Main.astro'
import { createTranslator } from '@/i18n'

const { user, locale } = Astro.locals
const projects = await listProjects(user!.id)
const t = createTranslator(locale)
---

<App title={t.common.projects}>
  <Main heading={t.common.projects} initialProjects={projects}>
    {
      projects.length ? (
        <div class="@container/project mt-4">
          <div class="@8xl/project:grid-cols-4 grid grid-cols-1 gap-4 @2xl/project:grid-cols-2 @5xl/project:grid-cols-3">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </div>
      ) : (
        <Empty />
      )
    }
  </Main>
</App>
